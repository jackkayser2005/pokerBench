# Web server
PORT=8080

# OpenRouter model config (choose one of these styles)
# If you set only OPENROUTER_MODEL, both players use it.
# Example single-model config
# OPENROUTER_MODEL=xai/grok-4-fast
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
# Or specify seats explicitly:
# OPENROUTER_MODEL_A=xai/grok-4-fast
# OPENROUTER_MODEL_B=openai/gpt-4o-mini

# Optional LLM knobs
# OPENROUTER_REASONING_EFFORT=low   # "", low, medium, high
# OPENROUTER_MAX_OUTPUT_TOKENS=     # number or leave blank to omit
# OPENROUTER_TEMPERATURE=0.2        # sampling temperature
# OPENROUTER_TOP_P=0.9              # nucleus sampling
# OPENROUTER_TOP_K=                 # top-k sampling (omit for default)

# OpenRouter API configuration
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=                 # alias of OPENROUTER_API_BASE
# OPENROUTER_API_KEY_HEADER=Authorization   # usually Authorization
# OPENROUTER_API_KEY_PREFIX=Bearer \        # prefix for the key value (default "Bearer " when using Authorization)
# OPENROUTER_SITE_URL=https://your-site.example.com     # required for personal keys (defaults to http://localhost)
# OPENROUTER_TITLE=PokerBench                           # optional label shown in OpenRouter logs
# LLM_COMPANY=OpenRouter                                # label stored in DB (auto-detected from base if unset)

# Poker config
SB=50
BB=100
START_STACK=10000
DUEL_SEEDS=5                   # mirrored pairs (1 pair = 2 hands)
# Deterministic seed controls (optional)
# DECK_SEED=123456789           # base for mirrored deck stream (falls back to crypto RNG)
# SEEDPACK=./seedpacks/stage-1.json      # path to JSON list of explicit seeds (alias of SEEDPACK_PATH)
# SEEDPACK_PATH=./seedpacks/stage-1.json # same as above; SEEDPACK_PATH takes precedence when both are set
ELO_PER_HAND=1                 # 1=true, 0=false
ELO_WEIGHT_BY_POT=1            # 1=true, 0=false

# Local Postgres (matches the docker-compose db service)
DATABASE_URL=postgres://poker:poker@db:5432/thunderdome?sslmode=disable

# Server / DB behavior
AUTO_MIGRATE=1                 # run schema.sql on startup
DEBUG=0
USE_COLOR=1

# Batch duels (pairwise): used by --duel-matrix
# OPENROUTER_MODELS=meta-llama/llama-3.1-70b-instruct,mistralai/mistral-nemo

# Secrets
# Place provider keys inside ./secrets (Docker Compose mounts it automatically).
# printf 'or-key-...' > ./secrets/openrouter_api_key.txt
# Or, for local runs without Docker, export directly:
# OPENROUTER_API_KEY=or-key-...
